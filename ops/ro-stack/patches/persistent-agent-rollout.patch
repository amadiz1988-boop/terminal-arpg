+bool persistent_agent_state_record_rollout_event(uint32 account_id, uint32 char_id,
+	const char* event_type, const char* error_code, const std::string& command_id, uint64 duration_ms) {
+	if (event_type == nullptr || event_type[0] == '\0')
+		return false;
+	const std::string event = escape_sql(std::string(event_type, strnlen(event_type, 48)));
+	const std::string error = error_code == nullptr ? std::string()
+		: escape_sql(std::string(error_code, strnlen(error_code, 64)));
+	const std::string command = escape_sql(command_id);
+	const std::string error_sql = error.empty() ? "NULL" : "'" + error + "'";
+	const std::string command_sql = command.empty() ? "NULL" : "'" + command + "'";
+	const std::string duration_sql = duration_ms == 0 ? "NULL" : std::to_string(duration_ms);
+	if (Sql_Query(mmysql_handle,
+		"INSERT INTO `persistent_agent_rollout_event` "
+		"(`account_id`,`char_id`,`event_type`,`error_code`,`command_id`,`duration_ms`) "
+		"VALUES ('%u','%u','%s',%s,%s,%s)", account_id, char_id, event.c_str(),
+		error_sql.c_str(), command_sql.c_str(), duration_sql.c_str()) == SQL_ERROR) {
+		Sql_ShowDebug(mmysql_handle);
+		return false;
+	}
+	return true;
+}
