+		reason = "ROLLOUT_SCHEMA_UNAVAILABLE";
+		return false;
+	}
+	policy_revision = policy.revision;
+	if (policy.emergency_disabled) {
+		reason = "EMERGENCY_DISABLED";
+		return false;
+	}
+	if (!policy.global_enabled) {
+		reason = "ROLLOUT_DISABLED";
+		return false;
+	}
+	if (!policy.identity_allowlisted) {
+		reason = "ROLLOUT_NOT_ALLOWLISTED";
+		return false;
+	}
+	if (require_eden_course_a && !policy.eden_course_a_enabled) {
+		reason = "EDEN_COURSE_A_DISABLED";
+		return false;
+	}
+	reason = nullptr;
+	return true;
