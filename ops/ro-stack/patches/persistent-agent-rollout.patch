+bool persistent_agent_state_load_rollout_policy(uint32 account_id, uint32 char_id,
+	PersistentAgentRolloutPolicy& policy) {
+	if (Sql_Query(mmysql_handle,
+		"SELECT p.`global_enabled`,p.`eden_course_a_enabled`,p.`emergency_disabled`,p.`revision`,"
+		"EXISTS(SELECT 1 FROM `persistent_agent_rollout_allowlist` a WHERE a.`enabled`=1 "
+		"AND a.`course_key`='eden_course_a_v1' AND (a.`account_id`='%u' OR a.`char_id`='%u')) "
+		"FROM `persistent_agent_rollout_policy` p WHERE p.`policy_id`=1 LIMIT 1",
+		account_id, char_id) == SQL_ERROR) {
+		Sql_ShowDebug(mmysql_handle);
+		return false;
+	}
+	const bool found = Sql_NextRow(mmysql_handle) == SQL_SUCCESS;
+	if (found) {
+		policy.global_enabled = sql_u64(0) != 0;
+		policy.eden_course_a_enabled = sql_u64(1) != 0;
+		policy.emergency_disabled = sql_u64(2) != 0;
+		policy.revision = sql_u64(3);
+		policy.identity_allowlisted = sql_u64(4) != 0;
+	}
+	Sql_FreeResult(mmysql_handle);
+	return found;
+}
